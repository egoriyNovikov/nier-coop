include "Math.fbs";

namespace nier;

// Packets sent from client to server
struct PlayerData {
    flashlight: bool;
    speed: float;
    facing: float;
    facing2: float;
    weapon_index: uint;
    pod_index: uint;
    held_button_flags: uint;
    position: nier.Vector3f;
}

struct AnimationStart {
    anim: uint;
    variant: uint;
    a3: uint;
    a4: uint;
}

// An enemy died in the sender's game. Each game has its own enemies, the receiver kills the one with
// the same model that was first seen at the same place.
struct EnemyDied {
    model: uint;
    spawn_position: nier.Vector3f;
    position: nier.Vector3f;
}

// Where the sender's game is in the story (src/mods/multiplayer/StoryWatcher.hpp).
table StoryState {
    phase: string; // e.g. "16_AB_bunker_Order"
    phase_id: int;
    scene_state_changes: uint; // story flags changed since the sender's game started
    event: uint; // story event (cutscene) playing now, ev%04x; 0 if none
    route: ubyte; // 'A', 'B', 'C' (scene state flags Route/A..C); 0 if unknown. Added in 3.2, older builds send 0
    character: string; // hero of the route: "2B", "9S", "A2" (scene state flags PL/..)
}

table Buttons {
    buttons: [uint]; // 8 buttons
}

// this is prepended onto the bounced packet from the server
table PlayerPacket {
    guid: ulong;
    data: [ubyte];
}

root_type PlayerPacket;