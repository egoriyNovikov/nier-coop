namespace nier;

// Bump Major when old and new builds can't play together, the server rejects a different Major.
enum VersionMajor : uint {
    Value = 3
}

enum VersionMinor : uint {
    Value = 1
}

enum VersionPatch : uint {
    Value = 0
}

table Hello {
    major: uint;
    minor: uint;
    patch: uint;
    name: string;
    password: string;
    model: uint;
    wants_host: bool; // The player leads the story: "Host Game" or the host role picked before "Join Game".
    mod_version: string; // Mod version and git revision, for the logs.
}

root_type Hello;